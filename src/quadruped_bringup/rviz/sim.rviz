Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 20
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
      Alpha: 1
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
      Show Names: true
      Marker Scale: 0.3
    - Class: rviz_default_plugins/Odometry
      Name: Noisy odometry (/odom)
      Enabled: true
      Topic:
        Value: /odom
      Keep: 200
      Position Tolerance: 0.1
      Angle Tolerance: 0.2
      Shape:
        Value: Arrow
        Color: 255; 80; 80
        Shaft Length: 0.3
        Head Length: 0.1
        Shaft Radius: 0.02
        Head Radius: 0.04
      Covariance:
        Value: false
    - Class: rviz_default_plugins/Odometry
      Name: Ground truth (/ground_truth/odom)
      Enabled: true
      Topic:
        Value: /ground_truth/odom
      Keep: 200
      Position Tolerance: 0.1
      Angle Tolerance: 0.2
      Shape:
        Value: Arrow
        Color: 80; 220; 80
        Shaft Length: 0.3
        Head Length: 0.1
        Shaft Radius: 0.02
        Head Radius: 0.04
      Covariance:
        Value: false
  Global Options:
    Fixed Frame: odom
    Background Color: 48; 48; 48
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 6
      Pitch: 0.9
      Yaw: 0.8
      Focal Point:
        X: 0
        Y: 0
        Z: 0
